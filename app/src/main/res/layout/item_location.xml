<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="location"
            type="com.example.appwithfirebase.models.Location" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <ImageView
            android:id="@+id/imageViewLocation"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:contentDescription="Imagen del item"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textViewLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Nombre del item"
            android:text="@{location.titulo}"
            app:layout_constraintEnd_toEndOf="@id/imageViewLocation"
            app:layout_constraintStart_toStartOf="@id/imageViewLocation"
            app:layout_constraintTop_toBottomOf="@id/imageViewLocation" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>